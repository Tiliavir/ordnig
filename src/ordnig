#!/usr/bin/env bash
# ordnig – entry point. Archive mounted at $ORDNIG_SRC, reports go to $ORDNIG_OUT.
set -euo pipefail

SRC=${ORDNIG_SRC:-/ablage}
OUT=${ORDNIG_OUT:-/report}
LIB=${ORDNIG_LIB:-/opt/ordnig}
STAMP=$(date +%Y-%m-%d_%H%M%S)
PY=(python3 -I)

usage() {
  cat <<EOF
ordnig – checks an old file archive and adds archival copies next to the originals.

  preview            (default) report + list of planned conversions. Changes nothing.
  run [opts]         report, convert, report again, store fresh checksums.
  check              report only. Skips the inbox, like run and verify.
  verify             compare against the stored checksums (<inbox>/.ordnig/manifest.sha256).
  sort [opts]        file the inbox (00_Eingang) into the archive. Preview unless --apply.
  version            versions of ordnig and the bundled tools.

Options for run (passed to the converter):
  --images tif,tiff  also OCR scanned images into PDF/A
  --lang deu+eng     Tesseract languages (default deu+eng; also: frk, fra, ita)
  --fix-scans        rotate and deskew scans (about 40% more OCR time)
  -j N               files in parallel (default: number of CPUs)
  --eingang PATH     inbox, if not $SRC/00_Eingang or $SRC/*/00_Eingang

Options for sort:
  --apply            really move the files (otherwise preview)
  --eval             measure on the archive itself how well sorting works
  --eingang PATH     inbox (default $SRC/00_Eingang or $SRC/*/00_Eingang)
  --ablage-geaendert many known documents are gone on purpose (archive reorganised)

Exit codes: 0 done · 1 errors in single files (sort, run) or changed/missing files
(verify) · 2 wrong call or setup (not mounted, read-only, bad regeln.toml, data from a
newer version) · 3 another run holds the lock · 4 sort: files wait in _Prüfen

State between runs (rules, learned texts, logs, checksums, lock) lives in <inbox>/.ordnig/;
an archive without inbox keeps it in $SRC/.ordnig/.

Mounts: archive -> $SRC, reports -> $OUT
EOF
}

need_dirs() {
  [[ -d $SRC ]] || { echo "Archive not mounted at $SRC (-v /path:$SRC)" >&2; exit 2; }
  mkdir -p "$OUT" || { echo "Report dir $OUT not writable" >&2; exit 2; }
}

INBOX=()    # --eingang from the options, so check finds the log of run
inbox_arg() {
  while (( $# )); do
    case $1 in
      --eingang) (( $# > 1 )) && INBOX=(--eingang "$2"); shift ;;
      --eingang=*) INBOX=("$1") ;;
    esac
    shift
  done
}

check() {   # $1 = label, $2 = console title, rest = extra args
  local label=$1 title=$2; shift 2
  local dir="$OUT/$STAMP-$label"
  "${PY[@]}" "$LIB/check.py" "$SRC" --out "$dir" --title "$title" "${INBOX[@]}" "$@"
  LAST_CHECK=$dir
}

# Checksum baseline for verify: state, so it lives with the archive (and its backup), not on
# the host. Each check also leaves its own copy in its report folder.
baseline() {
  local dir
  dir=$("${PY[@]}" "$LIB/state.py" dir "$SRC" "${INBOX[@]}") || exit 2
  BASELINE=$dir/manifest.sha256
}

store_manifest() {
  [[ -f $LAST_CHECK/manifest.sha256 ]] || return 0
  if mkdir -p "$(dirname "$BASELINE")" 2>/dev/null && cp "$LAST_CHECK/manifest.sha256" "$BASELINE.tmp" 2>/dev/null; then
    mv "$BASELINE.tmp" "$BASELINE"
  else
    echo "Prüfsummen nicht gespeichert: $(dirname "$BASELINE") nicht beschreibbar (Ablage :ro?)" >&2
  fi
}

cmd=${1:-preview}; [[ $# -gt 0 ]] && shift
inbox_arg "$@"
case $cmd in check|run|verify) need_dirs; baseline ;; esac
case $cmd in
  preview)
    need_dirs
    check check "Prüfung"
    echo
    "${PY[@]}" "$LIB/migrate.py" "$SRC" --report "$OUT/$STAMP-plan.md" "$@"
    ;;
  run)
    need_dirs
    [[ -w $SRC ]] || { echo "Archive is read-only – remove :ro for run" >&2; exit 2; }
    check before "Prüfung vorher" --quiet
    rc=0
    "${PY[@]}" "$LIB/migrate.py" "$SRC" --apply --report "$OUT/$STAMP-migration.md" "$@" || rc=$?
    (( rc == 1 )) || (( rc == 0 )) || exit "$rc"     # 2/3: nothing was converted
    echo
    check after "Prüfung nachher"
    store_manifest
    exit "$rc"
    ;;
  check)
    need_dirs; check check "Prüfung" "$@"; [[ -f $BASELINE ]] || store_manifest ;;
  verify)
    need_dirs
    [[ -f $BASELINE ]] || { echo "No $BASELINE yet – run 'check' or 'run' first" >&2; exit 2; }
    check verify "Bitrot-Prüfung" --verify "$BASELINE"
    ;;
  sort)
    need_dirs
    "${PY[@]}" "$LIB/sort.py" "$SRC" --report "$OUT/$STAMP-sort.md" "$@"
    ;;
  version|--version)
    if [[ -f $LIB/versions.txt ]]; then cat "$LIB/versions.txt"; else echo "versions.txt missing (not running in the image)"; fi ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
